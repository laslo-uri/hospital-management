<Window x:Class="HospitalDesktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:HospitalDesktop.Ui"
        Title="Hospital Management Suite"
        Height="620" Width="450"
        FontFamily="Segoe UI"
        FontWeight="SemiBold"
        Foreground="White"
        WindowStartupLocation="CenterScreen"
        Background="#FF009CDE">
  <DockPanel>
    <ui:CaptionBar x:Name="Caption" DockPanel.Dock="Top"
                   Title="Hospital Management Suite"
                   ShowMaximize="False"
                   AccentBrush="{StaticResource BrandCyanDeepBrush}"
                   CloseRequested="Caption_CloseRequested"/>
    <Grid>
      <Grid.Background>
        <ImageBrush ImageSource="/Assets/MainWindow-background.jpg" Stretch="UniformToFill"/>
      </Grid.Background>

      <StackPanel Margin="40" VerticalAlignment="Center">
        <ui:LanguageBar HorizontalAlignment="Right" Margin="0,0,0,12"/>
        <Image Source="/Assets/lekar-icons/hospital-icon.png"
               Width="104" Height="104" Margin="0,0,0,8"/>
        <TextBlock x:Name="TitleText"
                   FontSize="18" FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Foreground="White" Margin="0,0,0,4"/>
        <TextBlock x:Name="VersionText"
                   FontSize="12" FontStyle="Italic"
                   HorizontalAlignment="Center"
                   Foreground="{StaticResource SkyLabelBrush}" Margin="0,0,0,18"/>

        <TextBlock x:Name="UsernameLabel" FontSize="18" Padding="5"
                   Foreground="{StaticResource SkyLabelBrush}"
                   Width="200" HorizontalAlignment="Center"
                   FontStyle="Italic"/>
        <TextBox x:Name="UsernameBox" Width="200" Height="34"
                 FontSize="15" FontStyle="Italic"
                 VerticalContentAlignment="Center"
                 HorizontalAlignment="Center" Text="doctor"/>

        <TextBlock x:Name="PasswordLabel" FontSize="18" Padding="5" Margin="0,10,0,0"
                   Foreground="{StaticResource SkyLabelBrush}"
                   Width="200" HorizontalAlignment="Center"
                   FontStyle="Italic"/>
        <PasswordBox x:Name="PasswordBox" Width="200" Height="34"
                     FontSize="15" FontStyle="Italic"
                     VerticalContentAlignment="Center"
                     HorizontalAlignment="Center"/>

        <TextBlock x:Name="ErrorText" Foreground="#FFEBCD"
                   HorizontalAlignment="Center" TextWrapping="Wrap"
                   Width="260" Margin="0,8,0,0" TextAlignment="Center"/>

        <Button Width="150" Height="52" Margin="0,14,0,0"
                Style="{StaticResource PrimaryButton}"
                Click="SignIn_Click" HorizontalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Image Source="/Assets/lekar-icons/login-icon.png" Width="26" Margin="0,0,8,0"/>
            <TextBlock x:Name="SignInText" FontSize="15" FontWeight="SemiBold"
                       VerticalAlignment="Center" Foreground="Black"/>
          </StackPanel>
        </Button>

        <TextBlock x:Name="DemoHint"
                   FontSize="11" FontWeight="Normal"
                   HorizontalAlignment="Center" Margin="0,18,0,0"
                   Foreground="#CCFFFFFF" TextAlignment="Center" TextWrapping="Wrap" Width="280"/>
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>

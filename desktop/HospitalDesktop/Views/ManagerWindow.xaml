<Window x:Class="HospitalDesktop.Views.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:HospitalDesktop.Ui"
        Title="Manager desk — Hospital Management Suite"
        Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PaperBrush}">
  <DockPanel>
    <ui:CaptionBar x:Name="Caption" DockPanel.Dock="Top"
                   Title="Manager desk"
                   AccentBrush="{StaticResource BrandCyanDeepBrush}"
                   CloseRequested="Caption_CloseRequested"/>
    <Border DockPanel.Dock="Left" Style="{StaticResource CyanSideBar}" Width="200" Padding="10,16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <Border Width="72" Height="72" CornerRadius="36" Background="White" HorizontalAlignment="Center" Margin="0,0,0,8">
            <Image Source="/Assets/lekar-icons/hospital-icon.png" Margin="8" Stretch="Uniform"/>
          </Border>
          <TextBlock x:Name="UserLabel" Foreground="White" TextAlignment="Center" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
          <ui:LanguageBar Margin="8,0,8,12"/>
          <Button x:Name="NavRooms" Style="{StaticResource CyanNavButton}" Click="NavRooms_Click"/>
          <Button x:Name="NavInventory" Style="{StaticResource CyanNavButton}" Click="NavInventory_Click"/>
          <Button x:Name="NavJobs" Style="{StaticResource CyanNavButton}" Click="NavJobs_Click"/>
          <Button x:Name="NavMeds" Style="{StaticResource CyanNavButton}" Click="NavMeds_Click"/>
          <Button x:Name="NavAnn" Style="{StaticResource CyanNavButton}" Click="NavAnn_Click"/>
        </StackPanel>
        <Button x:Name="SignOutBtn" DockPanel.Dock="Bottom" Style="{StaticResource CyanNavButton}" Margin="8,0,8,8"
                VerticalAlignment="Bottom" Click="SignOut_Click"/>
      </DockPanel>
    </Border>

    <DockPanel Margin="16">
      <TextBlock x:Name="DeskTitle" DockPanel.Dock="Top" FontSize="26" FontWeight="Bold"
                 Foreground="{StaticResource BrandCyanDeepBrush}" Margin="0,0,0,12"/>
      <TabControl x:Name="Tabs">
        <TabItem x:Name="TabRooms">
          <DockPanel Margin="8">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
              <TextBox x:Name="RoomCode" Width="90" Margin="0,0,8,0" ToolTip="Code"/>
              <TextBox x:Name="RoomName" Width="160" Margin="0,0,8,0" ToolTip="Name"/>
              <ComboBox x:Name="RoomType" Width="120" Margin="0,0,8,0" SelectedIndex="0">
                <ComboBoxItem Content="EXAM"/>
                <ComboBoxItem Content="OR"/>
                <ComboBoxItem Content="WARD"/>
                <ComboBoxItem Content="WAREHOUSE"/>
                <ComboBoxItem Content="ORDINARY"/>
              </ComboBox>
              <TextBox x:Name="RoomFloor" Width="60" Text="1" Margin="0,0,8,0"/>
              <TextBox x:Name="RoomArea" Width="60" Text="20" Margin="0,0,8,0"/>
              <Button x:Name="AddRoomBtn" Style="{StaticResource PrimaryButton}" Click="AddRoom_Click"/>
              <TextBlock x:Name="RoomMsg" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#B91C1C"/>
            </StackPanel>
            <DataGrid x:Name="RoomsGrid">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="80"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100"/>
                <DataGridTextColumn Header="Floor" Binding="{Binding Floor}" Width="60"/>
                <DataGridTextColumn Header="m²" Binding="{Binding AreaSqm}" Width="60"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>
        <TabItem x:Name="TabInventory">
          <DataGrid x:Name="InventoryGrid" Margin="8">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Room" Binding="{Binding RoomCode}" Width="80"/>
              <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="100"/>
              <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60"/>
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>
        <TabItem x:Name="TabJobs">
          <ScrollViewer Margin="8">
            <StackPanel>
              <TextBlock Text="Schedule equipment transfer" FontWeight="Bold" Margin="0,0,0,6"/>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <ComboBox x:Name="XferFrom" Width="120" DisplayMemberPath="Code" Margin="0,0,8,0"/>
                <ComboBox x:Name="XferTo" Width="120" DisplayMemberPath="Code" Margin="0,0,8,0"/>
                <TextBox x:Name="XferItem" Width="140" Text="Monitor cart" Margin="0,0,8,0"/>
                <TextBox x:Name="XferQty" Width="40" Text="1" Margin="0,0,8,0"/>
                <TextBox x:Name="XferWhen" Width="150" Text="2026-09-08 10:00" Margin="0,0,8,0"/>
                <Button x:Name="ScheduleXferBtn" Style="{StaticResource PrimaryButton}" Click="ScheduleXfer_Click"/>
              </StackPanel>
              <DataGrid x:Name="XferGrid" Height="140" Margin="0,0,0,16">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="From" Binding="{Binding FromRoomCode}" Width="70"/>
                  <DataGridTextColumn Header="To" Binding="{Binding ToRoomCode}" Width="70"/>
                  <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="*"/>
                  <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="50"/>
                  <DataGridTextColumn Header="Apply at" Binding="{Binding ApplyAt}" Width="180"/>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock Text="Schedule room job" FontWeight="Bold" Margin="0,0,0,6"/>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <ComboBox x:Name="JobRoom" Width="120" DisplayMemberPath="Code" Margin="0,0,8,0"/>
                <ComboBox x:Name="JobType" Width="120" SelectedIndex="0" Margin="0,0,8,0">
                  <ComboBoxItem Content="RENOVATION"/>
                  <ComboBoxItem Content="SPLIT"/>
                  <ComboBoxItem Content="MERGE"/>
                </ComboBox>
                <TextBox x:Name="JobDetails" Width="200" Text="Maintenance" Margin="0,0,8,0"/>
                <TextBox x:Name="JobWhen" Width="150" Text="2026-09-09 09:00" Margin="0,0,8,0"/>
                <Button x:Name="ScheduleJobBtn" Style="{StaticResource PrimaryButton}" Click="ScheduleJob_Click"/>
              </StackPanel>
              <DataGrid x:Name="JobsGrid" Height="140">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Room" Binding="{Binding RoomCode}" Width="80"/>
                  <DataGridTextColumn Header="Type" Binding="{Binding JobType}" Width="110"/>
                  <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*"/>
                  <DataGridTextColumn Header="Apply at" Binding="{Binding ApplyAt}" Width="180"/>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock x:Name="JobsMsg" Margin="0,8,0,0" Foreground="#B91C1C"/>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem x:Name="TabMedicines">
          <DockPanel Margin="8">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
              <Button x:Name="ApproveMedBtn" Style="{StaticResource PrimaryButton}" Click="ApproveMed_Click" Margin="0,0,8,0"/>
              <Button x:Name="RejectMedBtn" Padding="12,8" Click="RejectMed_Click"/>
            </StackPanel>
            <DataGrid x:Name="MedicinesGrid">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="100"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>
        <TabItem x:Name="TabAnnouncements">
          <DockPanel Margin="8">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
              <TextBox x:Name="AnnTitle" ToolTip="Title"/>
              <TextBox x:Name="AnnBody" Height="60" AcceptsReturn="True" TextWrapping="Wrap"/>
              <Button x:Name="PostAnnBtn" Style="{StaticResource PrimaryButton}"
                      HorizontalAlignment="Left" Click="PostAnn_Click"/>
            </StackPanel>
            <DataGrid x:Name="AnnGrid">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="180"/>
                <DataGridTextColumn Header="Author" Binding="{Binding AuthorUsername}" Width="100"/>
                <DataGridTextColumn Header="Body" Binding="{Binding Body}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>
      </TabControl>
    </DockPanel>
  </DockPanel>
</Window>

<Window x:Class="HospitalDesktop.Views.SecretaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:HospitalDesktop.Ui"
        Title="Secretary desk — Hospital Management Suite"
        Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PaperBrush}">
  <DockPanel>
    <ui:CaptionBar x:Name="Caption" DockPanel.Dock="Top"
                   Title="Secretary desk"
                   AccentBrush="{StaticResource BrandCyanDeepBrush}"
                   CloseRequested="Caption_CloseRequested"/>
    <Border DockPanel.Dock="Top" Background="{StaticResource BrandCyanDeepBrush}" Padding="16,12">
      <Grid>
        <StackPanel Orientation="Horizontal">
          <Image Source="/Assets/lekar-icons/hospital-icon.png" Width="48" Margin="0,0,12,0"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="DeskTitle" FontSize="22" FontWeight="Bold" Foreground="White"/>
            <TextBlock x:Name="UserLabel" Foreground="#B3E5FC"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <ui:LanguageBar Margin="0,0,12,0"/>
          <Button x:Name="SignOutBtn" Style="{StaticResource GhostButton}" Click="SignOut_Click"/>
        </StackPanel>
      </Grid>
    </Border>
    <TabControl Margin="12">
      <TabItem Header="Appointments">
        <DockPanel Margin="8">
          <Border DockPanel.Dock="Bottom" BorderBrush="#CBD5E1" BorderThickness="1" Padding="12" Margin="0,8,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Doctor"/>
                <ComboBox x:Name="DoctorBox" DisplayMemberPath="DisplayName"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="Patient"/>
                <ComboBox x:Name="PatientBox" DisplayMemberPath="DisplayName"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Margin="0,0,8,0">
                <TextBlock Text="Start (local)"/>
                <TextBox x:Name="StartBox" Text="2026-09-07 14:00"/>
              </StackPanel>
              <StackPanel Grid.Column="3" Margin="0,0,8,0">
                <TextBlock Text="End (local)"/>
                <TextBox x:Name="EndBox" Text="2026-09-07 15:00"/>
              </StackPanel>
              <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                <ComboBox x:Name="TypeBox" Width="120" SelectedIndex="0" Margin="0,0,0,8">
                  <ComboBoxItem Content="EXAM"/>
                  <ComboBoxItem Content="OPERATION"/>
                  <ComboBoxItem Content="EMERGENCY"/>
                </ComboBox>
                <Button Content="Book" Style="{StaticResource PrimaryButton}" Click="Book_Click"/>
              </StackPanel>
            </Grid>
          </Border>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Cancel selected" Style="{StaticResource GhostButton}" Click="Cancel_Click"/>
            <TextBlock x:Name="Msg" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#B91C1C"/>
          </StackPanel>
          <DataGrid x:Name="ApptGrid">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="50"/>
              <DataGridTextColumn Header="When" Binding="{Binding StartsAt}" Width="180"/>
              <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100"/>
              <DataGridTextColumn Header="Doctor" Binding="{Binding DoctorUsername}" Width="100"/>
              <DataGridTextColumn Header="Patient" Binding="{Binding PatientUsername}" Width="100"/>
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
              <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="Register patient">
        <StackPanel Margin="16" MaxWidth="420" HorizontalAlignment="Left">
          <TextBox x:Name="RegUser" ToolTip="Username"/>
          <TextBox x:Name="RegPass" ToolTip="Password"/>
          <TextBox x:Name="RegFirst" ToolTip="First name"/>
          <TextBox x:Name="RegLast" ToolTip="Last name"/>
          <Button Content="Register patient" Style="{StaticResource PrimaryButton}"
                  HorizontalAlignment="Left" Click="Register_Click"/>
          <TextBlock x:Name="RegMsg" Margin="0,8,0,0"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="Vacations">
        <DockPanel Margin="8">
          <Border DockPanel.Dock="Bottom" Padding="12" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
              <ComboBox x:Name="VacDoctor" Width="180" DisplayMemberPath="DisplayName" Margin="0,0,8,0"/>
              <TextBox x:Name="VacStart" Width="150" Text="2026-09-20 00:00" Margin="0,0,8,0"/>
              <TextBox x:Name="VacEnd" Width="150" Text="2026-09-27 00:00" Margin="0,0,8,0"/>
              <TextBox x:Name="VacNote" Width="140" Text="Annual leave" Margin="0,0,8,0"/>
              <Button Content="Schedule" Style="{StaticResource PrimaryButton}" Click="VacSchedule_Click" Margin="0,0,8,0"/>
              <Button Content="Cancel selected" Style="{StaticResource GhostButton}" Click="VacCancel_Click"/>
            </StackPanel>
          </Border>
          <TextBlock x:Name="VacMsg" DockPanel.Dock="Bottom" Margin="0,4,0,0" Foreground="#B91C1C"/>
          <DataGrid x:Name="VacGrid">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Doctor" Binding="{Binding DoctorUsername}" Width="120"/>
              <DataGridTextColumn Header="Starts" Binding="{Binding StartsAt}" Width="180"/>
              <DataGridTextColumn Header="Ends" Binding="{Binding EndsAt}" Width="180"/>
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
              <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="Records">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <ComboBox x:Name="RecordPatient" Width="220" DisplayMemberPath="DisplayName" SelectionChanged="RecordPatient_Changed"/>
            <Button Content="Save summary" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="SaveRecord_Click"/>
          </StackPanel>
          <TextBox x:Name="RecordSummary" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>

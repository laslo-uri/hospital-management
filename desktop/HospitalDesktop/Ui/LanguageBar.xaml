<UserControl x:Class="HospitalDesktop.Ui.LanguageBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="28">
  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <TextBlock x:Name="LangLabel" Foreground="White" VerticalAlignment="Center"
               Margin="0,0,8,0" FontSize="12"/>
    <ComboBox x:Name="LangBox" Width="72" Height="24" FontSize="12"
              SelectionChanged="LangBox_SelectionChanged">
      <ComboBoxItem Content="EN" Tag="en"/>
      <ComboBoxItem Content="SR" Tag="sr"/>
      <ComboBoxItem Content="HU" Tag="hu"/>
    </ComboBox>
  </StackPanel>
</UserControl>
